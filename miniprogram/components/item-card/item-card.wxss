.item-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  border-left: 8rpx solid #2e9e63;
  padding: 24rpx 24rpx 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(180, 130, 100, 0.08);
}

.item-card-hover {
  background: #fffaf6;
}

.item-card.is-compact {
  padding: 20rpx 20rpx 20rpx 16rpx;
  margin-bottom: 14rpx;
}

.main {
  flex: 1;
  min-width: 0;
}

.line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2f2723;
  max-width: 62%;
}

.is-compact .name {
  font-size: 30rpx;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.line2 {
  margin-top: 8rpx;
  font-size: 28rpx;
}

.remaining {
  font-weight: 600;
}

.dot {
  color: #d8cbc2;
  margin: 0 8rpx;
}

.stock {
  color: #6b5b52;
}

.line3 {
  margin-top: 6rpx;
}

.meta {
  font-size: 24rpx;
  color: #9a8c84;
}

.hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #d9a400;
  background: #fff8e1;
  border-radius: 10rpx;
  padding: 6rpx 12rpx;
  display: inline-block;
}

.arrow {
  color: #d8cbc2;
  font-size: 40rpx;
  margin-left: 12rpx;
}
