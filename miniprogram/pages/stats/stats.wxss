.month-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(180, 130, 100, 0.08);
}

.month-label {
  font-size: 30rpx;
  font-weight: 600;
}

.month-arrow {
  font-size: 26rpx;
  color: #ff7a45;
}

.total-main {
  display: flex;
  align-items: baseline;
}

.total-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #2f2723;
  line-height: 1.1;
}

.total-unit {
  font-size: 30rpx;
  color: #6b5b52;
  margin-left: 8rpx;
}

.total-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.mom {
  font-size: 26rpx;
  font-weight: 600;
}

.missing {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #8a6a2f;
  background: #fff8e1;
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
}

/* ---------------- 横向条形 ---------------- */

.bar-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.bar-key {
  width: 130rpx;
  font-size: 26rpx;
  color: #6b5b52;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 24rpx;
  background: #f7efe9;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffb08a, #ff7a45);
  border-radius: 12rpx;
}

.bar-fill-2 {
  background: linear-gradient(90deg, #a8d5bd, #2e9e63);
}

.bar-value {
  width: 140rpx;
  text-align: right;
  font-size: 25rpx;
  color: #2f2723;
  flex-shrink: 0;
}

/* ---------------- 趋势柱状 ---------------- */

.chart {
  padding: 32rpx 20rpx 20rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 320rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.chart-value {
  font-size: 21rpx;
  color: #9a8c84;
  margin-bottom: 8rpx;
}

.chart-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chart-bar {
  width: 40rpx;
  background: #f0d9cb;
  border-radius: 10rpx 10rpx 0 0;
  min-height: 8rpx;
}

.chart-bar-current {
  background: linear-gradient(180deg, #ff9057, #ff7a45);
}

.chart-label {
  font-size: 22rpx;
  color: #9a8c84;
  margin-top: 12rpx;
}

/* ---------------- 预计月开销 ---------------- */

.pred-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f7f1ec;
}

.pred-row:last-child {
  border-bottom: none;
}

.pred-main {
  flex: 1;
  min-width: 0;
}

.pred-name {
  font-size: 29rpx;
  color: #2f2723;
}

.pred-sub {
  display: block;
  font-size: 23rpx;
  margin-top: 4rpx;
}

.pred-cost {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff7a45;
}

.pred-note {
  font-size: 23rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* ---------------- 排行榜 ---------------- */

.rank-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f7f1ec;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-index {
  width: 44rpx;
  font-size: 26rpx;
  color: #c9b8ae;
  font-weight: 600;
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: 29rpx;
  color: #2f2723;
}

.rank-sub {
  display: block;
  font-size: 23rpx;
  margin-top: 4rpx;
}

.rank-amount {
  font-size: 27rpx;
  color: #2f2723;
}
