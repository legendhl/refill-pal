.field {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f7f1ec;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 220rpx;
  font-size: 29rpx;
  color: #6b5b52;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
}

.picker {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
  color: #2f2723;
}

.note {
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.chip {
  font-size: 25rpx;
  color: #ff7a45;
  background: #fff0e8;
  border-radius: 28rpx;
  padding: 10rpx 26rpx;
}

.chip:active {
  background: #ffe0d0;
}

.footer {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.save-btn {
  flex: 1;
}
