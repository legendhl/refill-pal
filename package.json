{
  "name": "refillpal",
  "version": "1.0.0",
  "private": true,
  "description": "补货小管家 RefillPal - 家庭日用品补货管理小程序",
  "scripts": {
    "pretest": "node scripts/sync-shared.js",
    "test": "node --test test/*.test.js packages/*/test/*.test.js server/test/*.test.js apps/*/test/*.test.js",
    "sync": "node scripts/sync-shared.js",
    "check": "node scripts/check-json.js",
    "verify": "npm run sync && npm run check && npm test",
    "release-check": "node scripts/release-check.js",
    "server": "node server/src/main.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2"
  }
}
